    "tasks.delete.confirm": {
      "comment": "Knopf in der Rückfrage: löscht die Aufgabe.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "tasks.delete.message": {
      "comment": "Rückfrage vor dem Löschen, immer am Ende.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be undone."
          }
        }
      }
    },
    "tasks.delete.series": {
      "comment": "Rückfrage vor dem Löschen einer wiederkehrenden Aufgabe.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Serie endet damit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The series ends with it."
          }
        }
      }
    },
    "tasks.delete.subtasks %lld": {
      "comment": "Rückfrage vor dem Löschen: Zahl der Unteraufgaben, die mitgehen.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ihre Unteraufgabe wird mitgelöscht."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ihre %lld Unteraufgaben werden mitgelöscht."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Its subtask will be deleted too."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Its %lld subtasks will be deleted too."
                }
              }
            }
          }
        }
      }
    },
    "tasks.delete.title": {
      "comment": "Titel der Rückfrage vor dem Löschen.",
