{
  "sourceLanguage": "en",
  "strings": {
    "login.address.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter"
          }
        }
      }
    },
    "login.address.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address you open Yuvomi with in the browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse, unter der du Yuvomi im Browser öffnest."
          }
        }
      }
    },
    "login.address.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Yuvomi server"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Yuvomi-Server"
          }
        }
      }
    },
    "login.address.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server address"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveradresse"
          }
        }
      }
    },
    "login.address.scanFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The QR code from the web app already contains the server address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der QR-Code aus der Web-App enthält die Serveradresse schon."
          }
        }
      }
    },
    "login.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück"
          }
        }
      }
    },
    "login.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "login.code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code"
          }
        }
      }
    },
    "login.code.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen"
          }
        }
      }
    },
    "login.code.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the six-digit code from your authenticator app or one of your recovery codes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den sechsstelligen Code aus deiner Authenticator-App oder einen deiner Wiederherstellungscodes ein."
          }
        }
      }
    },
    "login.code.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two-factor authentication"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei-Faktor-Authentifizierung"
          }
        }
      }
    },
    "login.confirmPairing.encrypted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted connection"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselte Verbindung"
          }
        }
      }
    },
    "login.confirmPairing.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only sign in if you created the code yourself in your Yuvomi web app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich nur an, wenn du den Code selbst in deiner Yuvomi-Web-App erzeugt hast."
          }
        }
      }
    },
    "login.confirmPairing.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to this server?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei diesem Server anmelden?"
          }
        }
      }
    },
    "login.confirmPairing.unencrypted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unencrypted connection"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverschlüsselte Verbindung"
          }
        }
      }
    },
    "login.confirmPairing.unencrypted.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Others on the same network can read along. Only continue on a network you trust."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere im selben Netz können mitlesen. Fahre nur in einem Netz fort, dem du vertraust."
          }
        }
      }
    },
    "login.pairing.code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing code"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplungscode"
          }
        }
      }
    },
    "login.pairing.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create the code in the Yuvomi web app under Settings > Account > Signed-in devices. It is valid for 5 minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Code erzeugst du in der Yuvomi-Web-App unter Einstellungen > Konto > Angemeldete Geräte. Er gilt 5 Minuten."
          }
        }
      }
    },
    "login.password": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwort"
          }
        }
      }
    },
    "login.password.usePairingCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In with a Code Instead"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stattdessen mit Code anmelden"
          }
        }
      }
    },
    "login.problem.credentialNotStored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in couldn't be saved on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ließ sich auf diesem Gerät nicht speichern."
          }
        }
      }
    },
    "login.problem.invalidAddress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a server address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht nach einer Serveradresse aus."
          }
        }
      }
    },
    "login.problem.invalidCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is wrong or has expired."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code stimmt nicht oder ist abgelaufen."
          }
        }
      }
    },
    "login.problem.invalidCredentials": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username or password is wrong."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzername oder Passwort stimmt nicht."
          }
        }
      }
    },
    "login.problem.invalidPairingCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is invalid or has expired. Create a new one in the web app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code ungültig oder abgelaufen. Erzeuge in der Web-App einen neuen."
          }
        }
      }
    },
    "login.problem.invalidPairingLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a valid pairing link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link ist kein gültiger Kopplungslink."
          }
        }
      }
    },
    "login.problem.notAllowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account can't sign in to the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto kann sich nicht in der App anmelden."
          }
        }
      }
    },
    "login.problem.notYuvomi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Yuvomi server answers at this address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Adresse antwortet kein Yuvomi-Server."
          }
        }
      }
    },
    "login.problem.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Please wait a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Bitte warte einen Moment."
          }
        }
      }
    },
    "login.problem.tooOld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Yuvomi server is too old for the app and needs an update."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Yuvomi-Server ist zu alt für die App und muss aktualisiert werden."
          }
        }
      }
    },
    "login.problem.unexpectedResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server sent an unexpected answer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat unerwartet geantwortet."
          }
        }
      }
    },
    "login.problem.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server can't be reached. Check the address and your connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar. Prüfe die Adresse und deine Verbindung."
          }
        }
      }
    },
    "login.scan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan QR Code"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-Code scannen"
          }
        }
      }
    },
    "login.scan.foreign": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a Yuvomi pairing code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Kopplungscode von Yuvomi."
          }
        }
      }
    },
    "login.scan.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at the QR code in the web app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Kamera auf den QR-Code in der Web-App."
          }
        }
      }
    },
    "login.signIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmelden"
          }
        }
      }
    },
    "login.title": {
      "extractionState": "manual",
      "localizations": {
