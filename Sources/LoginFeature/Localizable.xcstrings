{
  "sourceLanguage": "en",
  "strings": {
    "login.address.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter"
          }
        }
      }
    },
    "login.address.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address you open Yuvomi with in the browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse, unter der du Yuvomi im Browser öffnest."
          }
        }
      }
    },
    "login.address.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Yuvomi server"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Yuvomi-Server"
          }
        }
      }
    },
    "login.address.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server address"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveradresse"
          }
        }
      }
    },
    "login.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück"
          }
        }
      }
    },
    "login.code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code"
          }
        }
      }
    },
    "login.code.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen"
          }
        }
      }
    },
    "login.code.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the six-digit code from your authenticator app or one of your recovery codes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den sechsstelligen Code aus deiner Authenticator-App oder einen deiner Wiederherstellungscodes ein."
          }
        }
      }
    },
    "login.code.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two-factor authentication"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei-Faktor-Authentifizierung"
          }
        }
      }
    },
    "login.password": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwort"
          }
        }
      }
    },
    "login.problem.credentialNotStored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in couldn't be saved on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ließ sich auf diesem Gerät nicht speichern."
          }
        }
      }
    },
    "login.problem.invalidAddress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a server address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht nach einer Serveradresse aus."
          }
        }
      }
    },
    "login.problem.invalidCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is wrong or has expired."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code stimmt nicht oder ist abgelaufen."
          }
        }
      }
    },
    "login.problem.invalidCredentials": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username or password is wrong."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzername oder Passwort stimmt nicht."
          }
        }
      }
    },
    "login.problem.notAllowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account can't sign in to the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto kann sich nicht in der App anmelden."
          }
        }
      }
    },
    "login.problem.notYuvomi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Yuvomi server answers at this address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Adresse antwortet kein Yuvomi-Server."
          }
        }
      }
    },
    "login.problem.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Please wait a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Bitte warte einen Moment."
          }
        }
      }
    },
    "login.problem.tooOld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Yuvomi server is too old for the app and needs an update."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Yuvomi-Server ist zu alt für die App und muss aktualisiert werden."
          }
        }
      }
    },
    "login.problem.unexpectedResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server sent an unexpected answer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat unerwartet geantwortet."
          }
        }
      }
    },
    "login.problem.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server can't be reached. Check the address and your connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar. Prüfe die Adresse und deine Verbindung."
          }
        }
      }
    },
    "login.signIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmelden"
          }
        }
      }
    },
    "login.ssoOnly.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server only allows sign-in through your organization's login. Pairing with the web app is coming in a later version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server erlaubt nur die Anmeldung über das Login deiner Organisation. Das Koppeln mit der Web-App kommt in einer späteren Version."
          }
        }
      }
    },
    "login.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign In"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmelden"
          }
        }
      }
    },
    "login.username": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzername"
          }
        }
      }
    }
  },
  "version": "1.0"
}
